local function newIcon(btn)
	local holder = make("Frame", {
		Size = UDim2.new(0, 20, 0, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundTransparency = 1,
	}, btn)
	return { holder = holder, fills = {}, strokes = {} }
end

-- filled rectangle centered on (cx, cy), optional rotation / rounding
local function rect(icon, cx, cy, w, h, rot, round)
	local f = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, cx, 0, cy),
		Size = UDim2.new(0, w, 0, h),
		Rotation = rot or 0,
		BackgroundColor3 = C.Gray,
		BorderSizePixel = 0,
	}, icon.holder)
	if round then
		corner(f, round)
	end
	table.insert(icon.fills, f)
	return f
end

-- empty circle with a thick outline
local function ring(icon, cx, cy, d, thick)
	local f = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, cx, 0, cy),
		Size = UDim2.new(0, d, 0, d),
		BackgroundTransparency = 1,
	}, icon.holder)
	corner(f, d)
	table.insert(icon.strokes, stroke(f, C.Gray, thick))
	return f
end

local function setIconColor(icon, col)
	for _, f in ipairs(icon.fills) do
		f.BackgroundColor3 = col
	end
	for _, s in ipairs(icon.strokes) do
		s.Color = col
	end
end

