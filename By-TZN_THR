	local eggStatus = "--"
	local eggNextAt = 0
	local EGG_DURATION = 30 * 60 + 3

	local function eggTools()
		local found = {}
		local lists = {}
		if player.Character then
			lists[#lists + 1] = player.Character
		end
		local bp = player:FindFirstChild("Backpack")
		if bp then
			lists[#lists + 1] = bp
		end
		for _, c in ipairs(lists) do
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find("egg", 1, true) then
					found[#found + 1] = t
				end
			end
		end
		return found
	end

	local function findEggTool()
		for _, t in ipairs(eggTools()) do
			if t.Name:lower():find("protein egg", 1, true) then
				return t
			end
		end
		return eggTools()[1]
	end

	local function eatEgg()
		local tool = findEggTool()
		if not tool then
			return "none"
		end
		local ev = findMuscleEvent()
		if not ev then
			return "unconfirmed"
		end
		pcall(function()
			ev:FireServer("proteinEgg", tool)
		end)
		return "eaten"
	end

	local eggLbl
	local function autoEggLoop(myId)
		local noEgg = 0
		eggNextAt, eggStatus = 0, "--"
		while eggRunId == myId and farm.alive do
			if tick() >= eggNextAt then
				local ok, res = pcall(eatEgg)
				if (not ok) or res == "none" then
					noEgg += 1
					eggStatus = "no egg"
					if noEgg >= 3 then
						return
					end
				elseif res == "eaten" then
					noEgg = 0
					eggEaten += 1
					eggStatus = "eaten"
					eggNextAt = tick() + EGG_DURATION
				end
			end
			task.wait(1)
		end
	end
