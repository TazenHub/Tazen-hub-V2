local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function forceSafeZone()
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	-- Sauvegarde de la position actuelle
	local currentCFrame = rootPart.CFrame

	-- Étape 1 : Téléportation vers l'île / zone cachée (exemple de coordonnées sous la map)
	-- À adapter si l'île a des coordonnées précises dans le jeu
	rootPart.CFrame = CFrame.new(0, -500, 0)
	
	task.wait(0.1) -- Laisse le temps au serveur de valider la zone

	-- Étape 2 : Retour immédiat au lobby / position initiale
	rootPart.CFrame = currentCFrame
end

-- Déclenchement via une touche (par exemple la touche G)
local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.G then
		forceSafeZone()
		print("Tentative d'activation de la safe zone via téléportation.")
	end
end)
