		serverSubs[2].Text = Players.MaxPlayers .. " players can join"
		local ping = getPing()
		serverSubs[3].Text = ping and (ping .. "ms") or "N/A"
		serverSubs[5].Text = fmtTime(os.clock() - joinedAt)
		refreshFriendsInServer()
		task.wait(1)
	end
end)

