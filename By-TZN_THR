local function newIcon(btn)
	local holder = make("Frame", {
		Size = UDim2.new(0, 20, 0, 20),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundTransparency = 1,
	}, btn)
	return { holder = holder, fills = {}, strokes = {} }
end

local function rect(icon, cx, cy, w, h, rot, round)
	local f = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, cx, 0, cy),
		Size = UDim2.new(0, w, 0, h),
		Rotation = rot or 0,
		BackgroundColor3 = C.Gray,
		BorderSizePixel = 0,
	}, icon.holder)
	if round then
		corner(f, round)
	end
	table.insert(icon.fills, f)
	return f
end

local function ring(icon, cx, cy, d, thick)
	local f = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, cx, 0, cy),
		Size = UDim2.new(0, d, 0, d),
		BackgroundTransparency = 1,
	}, icon.holder)
	corner(f, d)
	table.insert(icon.strokes, stroke(f, C.Gray, thick))
	return f
end

local function setIconColor(icon, col)
	for _, f in ipairs(icon.fills) do
		f.BackgroundColor3 = col
	end
	for _, s in ipairs(icon.strokes) do
		s.Color = col
	end
end

local function drawHome(icon)
	rect(icon, 5.1, 6.2, 12, 3, -35, 1.5)
	rect(icon, 14.9, 6.2, 12, 3, 35, 1.5)
	rect(icon, 5.5, 14, 2, 8, 0, 1)
	rect(icon, 14.5, 14, 2, 8, 0, 1)
	rect(icon, 10, 18, 11, 2, 0, 1)
	rect(icon, 10, 15.2, 3.5, 5.5, 0, 1)
end

local function drawBolt(icon)
	rect(icon, 9.5, 6, 13.5, 3, 132, 1.5)
	rect(icon, 9, 10.5, 8, 3, -7, 1.5)
	rect(icon, 10.5, 14.5, 10.3, 3, 119, 1.5)
end

local function drawGear(icon)
	ring(icon, 10, 10, 9, 3)
	for i = 0, 7 do
		local a = math.rad(i * 45)
		rect(icon, 10 + math.cos(a) * 7.8, 10 + math.sin(a) * 7.8, 3.6, 3.6, i * 45, 1)
	end
end

