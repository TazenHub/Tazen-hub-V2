			task.spawn(fastRebirthLoop, macroId)
		else
			macroStart = nil
			lastMacroRebirthTime = nil
			macroStatus.Text = "Stopped."
			macroLastTimeLbl.Text = "Last rebirth: --"
		end
	end)
	local macroLbl = addInfo(macroPage, 4, "Rebirths: 0 (0)", 34)
	macroLastTimeLbl = addInfo(macroPage, 5, "Last rebirth: --", 34)
	local macroCalcLbl = addInfo(macroPage, 6, "Rebirths Tot: 0 | 1m: 0 | 1h: 0 | 1d: 0 | 1w: 0 | 1mo: 0", 50)

	-- DÉTECTION INSTANTANÉE DU TEMPS PAR RENAISSANCE
	task.spawn(function()
		local rbStat = getRebirthStat()
		while farm.alive and not rbStat do
			task.wait(1)
			rbStat = getRebirthStat()
		end
		if rbStat and rbStat:IsA("ValueBase") then
			local prevVal = tonumber(rbStat.Value) or 0
			local c = rbStat.Changed:Connect(function(newVal)
				local numVal = tonumber(newVal) or 0
				if numVal > prevVal then
					local now = os.clock()
					if rebirthStart and lastRebirthTime then
						local diff = now - lastRebirthTime
						lastRebirthTime = now
						rebirthLastTimeLbl.Text = string.format("Last rebirth: %.2fs", diff)
					end
					if macroStart and lastMacroRebirthTime then
						local diff = now - lastMacroRebirthTime
						lastMacroRebirthTime = now
						macroLastTimeLbl.Text = string.format("Last rebirth: %.2fs", diff)
					end
				end
				prevVal = numVal
			end)
			table.insert(conns, c)
		end
	end)

	-- LIVE STATS
	task.spawn(function()
		while farm.alive do
			pcall(function()
				local curRb = getRebirths()
				local curStr = getStrength()
				local now = tick()

				local rbDisplay = "Rebirths: " .. formatDual(curRb)
