	-- 3. FAST REBIRTH : Détection de force requise, farm avec rep pets, puis bascule sur les pets x2 rep/rebirth (tribal) et rebirth
	local function fastRebirthLoop(myId)
		local function running()
			return farm.alive and macroId == myId
		end
		local rEvents = ReplicatedStorage:WaitForChild("rEvents", 5)
		local rebirthRemote = rEvents and rEvents:WaitForChild("rebirthRemote", 5)
		local equipPetEvent = rEvents and rEvents:WaitForChild("equipPetEvent", 5)
		if not (rebirthRemote and equipPetEvent) then
			return
		end

		local function petCall(action, pet)
			pcall(equipPetEvent.FireServer, equipPetEvent, action, pet)
		end

		local petsFolder = player:FindFirstChild("petsFolder")
		while running() and not petsFolder do
			task.wait(1)
			petsFolder = player:FindFirstChild("petsFolder")
		end

		local muscle = getMuscleEvent()
		local rebirthsStat = getRebirthStat()
		local strengthStat = getStrengthStat()
		local all, tribal, repPets = {}, {}, {}
		local cycles = 0

		-- Fonction pour détecter la force requise pour la renaissance dans l'interface ou par estimation
		local function getRequiredStrength()
			local ok, req = pcall(function()
				local playerGui = player:FindFirstChild("PlayerGui")
				if playerGui then
					local mainGui = playerGui:FindFirstChild("MainGui") or playerGui:FindFirstChild("ScreenGui")
					if mainGui then
						for _, desc in ipairs(mainGui:GetDescendants()) do
							if desc:IsA("TextLabel") and (desc.Name:lower():find("req") or desc.Name:lower():find("strength") or desc.Text:lower():find("/")) then
								local txt = desc.Text
								local numStr = txt:match("/%s*([%d,%.]+[kKmMbBtTqQ]?)") or txt:match("([%d,%.]+[kKmMbBtTqQ]?)%s*req")
								if numStr then
									numStr = numStr:gsub(",", "")
									local mult = 1
									if numStr:lower():find("k") then mult = 1e3
									elseif numStr:lower():find("m") then mult = 1e6
									elseif numStr:lower():find("b") then mult = 1e9
									elseif numStr:lower():find("t") then mult = 1e12
									elseif numStr:lower():find("q") then mult = 1e15 end
									local cleanNum = tonumber(numStr:match("[%d%.]+"))
									if cleanNum then return cleanNum * mult end
								end
							end
						end
					end
				end
				return nil
			end)
			if ok and req then return req end
			local currentRb = getRebirths()
			return 10000 + (currentRb * 5000)
		end

		while running() do
			if petsFolder and cycles % 15 == 0 then
				all, tribal, repPets = scanPets(petsFolder)
				for _, pet in ipairs(all) do
					petCall("unequipPet", pet)
				end
				muscle = (muscle and muscle.Parent) and muscle or getMuscleEvent()
			end
			cycles += 1

			-- Étape A : Équiper les pets de rep et envoyer les reps jusqu'à atteindre la force requise
			for _, pet in ipairs(repPets) do
				petCall("equipPet", pet)
			end

			local carry = 0
			local targetStrength = getRequiredStrength()

			while running() do
				local currentStrength = strengthStat and tonumber(strengthStat.Value) or 0
				if currentStrength >= targetStrength then
					break
				end

				local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
				if muscle then
					carry += REP_CAP * dt
					local n = math.floor(carry)
					if n > 0 then
						carry -= n
						pcall(burst, muscle, n)
					end
				end
			end

			for _, pet in ipairs(repPets) do
				petCall("unequipPet", pet)
			end
			if not running() then
				break
			end

			-- Étape B : Stopper les reps, équiper les pets x2 rep/rebirth (tribal) et lancer la renaissance
			for _, pet in ipairs(tribal) do
				petCall("equipPet", pet)
			end

			local initial = rebirthsStat and rebirthsStat.Value or 0
			local done = false
			while running() and not done do
				RunService.Heartbeat:Wait()
				pcall(rebirthRemote.InvokeServer, rebirthRemote, "rebirthRequest")
				if rebirthsStat and rebirthsStat.Value > initial then
					done = true
				end
			end

			for _, pet in ipairs(tribal) do
				petCall("unequipPet", pet)
			end
		end
	end

