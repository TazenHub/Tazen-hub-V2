	-- Username Spoofer : replaces your name on labels so it's harder to screen-clip
	local spooferEnabled = false
	local spoofedName = "Anonyme"
	local function sanitizeText(txt)
		if type(txt) ~= "string" then
			return txt
		end
		local realName, displayName = player.Name, player.DisplayName
		local modified = txt
		if realName ~= "" and modified:find(realName, 1, true) then
			modified = modified:gsub(realName, spoofedName)
		end
		if displayName ~= "" and modified:find(displayName, 1, true) then
			modified = modified:gsub(displayName, spoofedName)
		end
		return modified
	end

	local function applySpoofer(inst)
		pcall(function()
			if not spooferEnabled then
				return
			end
			if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
				local newText = sanitizeText(inst.Text)
				if newText ~= inst.Text then
					inst.Text = newText
				end
			end
		end)
	end

	local function scanAndHook(container)
		pcall(function()
			for _, d in ipairs(container:GetDescendants()) do
				applySpoofer(d)
			end
			connect2(container.DescendantAdded, function(d)
				applySpoofer(d)
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					connect2(d:GetPropertyChangedSignal("Text"), function()
						applySpoofer(d)
					end)
				end
			end)
		end)
	end

