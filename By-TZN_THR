	--------------------------------------------------------
	-- UI BUILDERS (take the page they build into)
	--------------------------------------------------------
	local function rowFrame(page, order, h)
		local r = make("Frame", {
			Size = UDim2.new(1, 0, 0, h or 40),
			BackgroundColor3 = C.Card,
			BorderSizePixel = 0,
			LayoutOrder = order,
		}, page)
		corner(r, 8)
		stroke(r, C.Stroke, 1)
		return r
	end

	local function addTitle(page, text)
		label(page, text, 14, B, C.White, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 20)).LayoutOrder = 1
	end

	local function addInfo(page, order, text, h)
		local r = rowFrame(page, order, h or 34)
		local l = label(r, text, 11, G, C.Gray, UDim2.new(0, 12, 0, 0), UDim2.new(1, -24, 1, 0))
		l.TextWrapped = true
		return l
	end

	local function addToggle(page, order, text, callback)
		local r = rowFrame(page, order, 40)
		label(r, text, 12, G, C.White, UDim2.new(0, 12, 0, 0), UDim2.new(1, -70, 1, 0))
		local sw = make("TextButton", {
			Size = UDim2.new(0, 38, 0, 20),
			Position = UDim2.new(1, -50, 0.5, -10),
			BackgroundColor3 = C.Tile,
			Text = "",
			AutoButtonColor = false,
		}, r)
		corner(sw, 10)
		local swStroke = stroke(sw, C.Stroke, 1)
		local knob = make("Frame", {
			Size = UDim2.new(0, 14, 0, 14),
			Position = UDim2.new(0, 3, 0.5, -7),
			BackgroundColor3 = C.Gray,
		}, sw)
		corner(knob, 7)

		local obj = { Value = false }
		function obj:Set(v, silent)
			self.Value = v
			TweenService:Create(knob, TweenInfo.new(0.15), {
				Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
				BackgroundColor3 = v and C.White or C.Gray,
			}):Play()
			TweenService:Create(sw, TweenInfo.new(0.15), {
				BackgroundColor3 = v and C.PinkDark or C.Tile,
			}):Play()
			swStroke.Color = v and C.Pink or C.Stroke
			if callback and not silent then
				callback(v)
			end
		end
		sw.MouseButton1Click:Connect(function()
			obj:Set(not obj.Value)
		end)
		return obj
	end

	local function addSlider(page, order, text, min, max, default, callback)
		local r = rowFrame(page, order, 54)
		label(r, text, 12, G, C.White, UDim2.new(0, 12, 0, 6), UDim2.new(1, -100, 0, 18))
		local val = label(r, tostring(default), 12, B, C.Pink, UDim2.new(1, -82, 0, 6), UDim2.new(0, 70, 0, 18), Enum.TextXAlignment.Right)
		local track = make("Frame", {
			Size = UDim2.new(1, -24, 0, 6),
			Position = UDim2.new(0, 12, 0, 36),
			BackgroundColor3 = C.Tile,
			BorderSizePixel = 0,
		}, r)
		corner(track, 3)
		local fill = make("Frame", {
			Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
			BackgroundColor3 = C.Pink,
			BorderSizePixel = 0,
		}, track)
		corner(fill, 3)
		local hit = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.new(0, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = "",
		}, r)

		local dragging = false
		local function setFromX(x)
			local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local v = math.floor(min + rel * (max - min) + 0.5)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			val.Text = tostring(v)
			callback(v)
		end
		local function isPointer(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end
		hit.InputBegan:Connect(function(input)
			if isPointer(input) then
				dragging = true
				page.ScrollingEnabled = false
				setFromX(input.Position.X)
			end
		end)
		table.insert(conns, UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end))
		table.insert(conns, UserInputService.InputEnded:Connect(function(input)
			if dragging and isPointer(input) then
				dragging = false
				page.ScrollingEnabled = true
			end
		end))
		callback(default)
	end

	--------------------------------------------------------
	-- GAME HELPERS
	--------------------------------------------------------
	local function fmtNum(v)
		if type(v) ~= "number" or v ~= v then
			return "0"
		end
		local units = {
			{ 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "k" },
		}
		for _, u in ipairs(units) do
			if v >= u[1] then
				return string.format("%.2f%s", v / u[1], u[2])
			end
		end
		return tostring(math.floor(v))
	end

	local function getRebirthStat()
		local ls = player:FindFirstChild("leaderstats")
		return ls and (ls:FindFirstChild("Rebirths") or ls:FindFirstChild("Rebirth"))
	end

	local function getRebirths()
		local rb = getRebirthStat()
		if rb and rb:IsA("ValueBase") then
			return tonumber(rb.Value) or 0
		end
		return 0
	end

	local function getRebirthRemote()
		local rEvents = ReplicatedStorage:WaitForChild("rEvents", 5)
		return rEvents and rEvents:WaitForChild("rebirthRemote", 5)
	end

	local function findMuscleEvent()
		local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
		return player:FindFirstChild("muscleEvent")
			or (player.Character and player.Character:FindFirstChild("muscleEvent"))
			or (rEvents and rEvents:FindFirstChild("muscleEvent"))
	end

	local function equipToolByName(keyword)
		pcall(function()
			local char = player.Character
			local backpack = player:FindFirstChild("Backpack")
			if not char or not backpack then
				return
			end
			keyword = keyword:lower()
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword, 1, true) then
					return -- already equipped
				end
			end
			for _, t in ipairs(backpack:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword, 1, true) then
					t.Parent = char
					return
				end
			end
		end)
	end

	local function burst(ev, n)
		for _ = 1, n do
			ev:FireServer("rep")
		end
	end

	-- Several rebirth requests in flight at once (InvokeServer waits for the server's reply)
	local function startWorkers(remote, count, gate)
		for _ = 1, count do
			task.spawn(function()
				while gate() do
					pcall(remote.InvokeServer, remote, "rebirthRequest")
					RunService.Heartbeat:Wait()
				end
			end)
		end
	end

	--------------------------------------------------------
	-- TOOL MANAGER (one tool at a time, shared by every tab)
	--------------------------------------------------------
	local toolWanted, toolLoopId = nil, 0
	local toolToggles = {}

	local function unequipToolByName(keyword)
		pcall(function()
			local char = player.Character
			local backpack = player:FindFirstChild("Backpack")
			if not char or not backpack then
				return
			end
			keyword = keyword:lower()
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword, 1, true) then
					t.Parent = backpack
				end
			end
		end)
	end

	-- name = "weight" / "pushup" / nil (nothing). Keeps the tool equipped (even after a respawn).
	local function setTool(name)
		local old = toolWanted
		toolWanted = name
		toolLoopId += 1
		if old and old ~= name then
			unequipToolByName(old)
		end
		for _, e in ipairs(toolToggles) do
			e.toggle:Set(e.tool == name, true)
		end
		if name then
			local myId = toolLoopId
			task.spawn(function()
				while farm.alive and toolLoopId == myId do
					equipToolByName(name)
					task.wait(1)
				end
			end)
		end
	end

	local function ensureTool(default)
		if not toolWanted then
			setTool(default)
		end
	end

	local function addToolToggle(page, order, text, keyword)
		local t
		t = addToggle(page, order, text, function(v)
			setTool(v and keyword or nil)
		end)
		table.insert(toolToggles, { toggle = t, tool = keyword })
		return t
	end

	--------------------------------------------------------
	-- LOOPS (one per feature, completely independent)
	--------------------------------------------------------
	-- sends reps at `rate` per second while gate() is true
	local function repPump(gate, rate, onSent)
		local muscle = findMuscleEvent()
		local carry, lastLook = 0, 0
		while gate() do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
			if muscle and muscle.Parent then
				carry += rate * dt
				local n = math.floor(carry)
				if n > 0 then
					carry -= n
					pcall(burst, muscle, n)
					onSent(n)
				end
			elseif tick() - lastLook > 1 then
				lastLook = tick()
				muscle = findMuscleEvent()
			end
		end
	end

	-- AUTO REBIRTH : rebirth requests non-stop + reps (so there is strength to rebirth with)
	local function rebirthLoop(myId)
		local function running()
			return farm.alive and rebirthId == myId
		end
		local remote = getRebirthRemote()
		if not remote then
			warn("[Tazen Hub] Rebirth remote not found")
			return
		end
		startWorkers(remote, REBIRTH_WORKERS, running)
		repPump(running, REP_CAP, function(n)
			rebirthRepTotal += n
		end)
	end

	-- FAST FARMING : only reps
	local function strengthLoop(myId)
		repPump(function()
			return farm.alive and strengthId == myId
		end, REP_CAP, function(n)
			strengthTotal += n
		end)
	end

	-- FAST REBIRTH : reps non-stop + a rebirth attempt every few seconds
	local function macroLoop(myId)
		local function running()
			return farm.alive and macroId == myId
		end
		local remote = getRebirthRemote()
		if not remote then
			warn("[Tazen Hub] Rebirth remote not found")
			return
		end

		local muscle = findMuscleEvent()
		local rebirthStat = getRebirthStat()
		local carry, lastLook = 0, 0
		local trying, tryEnd, nextTry, initial, token = false, 0, 0, 0, 0

		while running() do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)

			-- 1) reps never stop
			if muscle and muscle.Parent then
				carry += macroRate * dt
				local n = math.floor(carry)
				if n > 0 then
					carry -= n
					pcall(burst, muscle, n)
					macroTotal += n
				end
			elseif tick() - lastLook > 1 then
				lastLook = tick()
				muscle = findMuscleEvent()
			end

			-- 2) every `macroInterval` seconds, try to rebirth for a short window
			local now = tick()
			if trying then
				local ok = rebirthStat and rebirthStat.Value > initial
				if ok or now >= tryEnd then
					trying = false
					nextTry = now + macroInterval
				end
			elseif now >= nextTry then
				trying = true
				tryEnd = now + TRY_WINDOW
				initial = rebirthStat and rebirthStat.Value or 0
				macroTries += 1
				token += 1
				local myToken = token
				startWorkers(remote, MACRO_WORKERS, function()
					return running() and trying and token == myToken
				end)
			end
		end
		trying = false
	end

	--------------------------------------------------------
	-- SHARED STOP / GUARD LOGIC
	--------------------------------------------------------
	local rebirthToggle, strengthToggle, macroToggle
	local rebirthStatus, strengthStatus, macroStatus

	local function stopRebirth()
		rebirthId += 1
		rebirthStart = nil
		rebirthToggle:Set(false, true)
		rebirthStatus.Text = "Stopped."
	end
	local function stopStrength()
		strengthId += 1
		strengthStart = nil
		strengthToggle:Set(false, true)
		strengthStatus.Text = "Stopped."
	end
	local function stopMacro()
		macroId += 1
		macroStart = nil
		macroToggle:Set(false, true)
		macroStatus.Text = "Stopped."
	end

	-- the three features all send reps, so only one can run at a time
	local function stopOthers(except)
		if except ~= "rebirth" and rebirthToggle.Value then
			stopRebirth()
		end
		if except ~= "strength" and strengthToggle.Value then
			stopStrength()
		end
		if except ~= "macro" and macroToggle.Value then
			stopMacro()
		end
	end

	local function allowed(toggle, status, v)
		if v and not isMuscleGame then
			toggle:Set(false, true)
			status.Text = "Wrong game: Muscle Legends only."
			return false
		end
		return true
	end

	local wrong = "Wrong game: Muscle Legends only."

	--------------------------------------------------------
	-- AUTO REBIRTH TAB
	--------------------------------------------------------
	addTitle(rebirthPage, "Auto Rebirth")
	rebirthStatus = addInfo(rebirthPage, 2, isMuscleGame and "Rebirth requests + reps, non-stop. No pets, no pass." or wrong, 30)

	rebirthToggle = addToggle(rebirthPage, 3, "Auto Rebirth", function(v)
		if not allowed(rebirthToggle, rebirthStatus, v) then
			return
		end
		rebirthId += 1
		if v then
			stopOthers("rebirth")
			ensureTool("weight")
			rebirthStart = os.clock()
			rebirthBase = getRebirths()
			rebirthRepTotal = 0
			rebirthStatus.Text = "Running..."
			task.spawn(rebirthLoop, rebirthId)
		else
			rebirthStart = nil
			rebirthStatus.Text = "Stopped."
		end
	end)
	addToolToggle(rebirthPage, 4, "Equip Weight", "weight")
	local rebirthLbl = addInfo(rebirthPage, 5, "Rebirths: -", 50)

	--------------------------------------------------------
	-- FAST FARMING TAB
	--------------------------------------------------------
	addTitle(strengthPage, "Fast Farming")
	strengthStatus = addInfo(strengthPage, 2, isMuscleGame and "Only sends reps. No pets, no pass." or wrong, 30)

	strengthToggle = addToggle(strengthPage, 3, "Fast Farming", function(v)
		if not allowed(strengthToggle, strengthStatus, v) then
			return
		end
		strengthId += 1
		if v then
			stopOthers("strength")
			ensureTool("pushup")
			strengthStart = os.clock()
			strengthTotal = 0
			strengthStatus.Text = "Running..."
			task.spawn(strengthLoop, strengthId)
		else
			strengthStart = nil
			strengthStatus.Text = "Stopped."
		end
	end)
	addToolToggle(strengthPage, 4, "Equip Weight", "weight")
	addToolToggle(strengthPage, 5, "Equip Pushup", "pushup")
	local strengthLbl = addInfo(strengthPage, 6, "Reps sent: 0 | Avg: 0/s", 34)

	--------------------------------------------------------
	-- FAST REBIRTH TAB
	--------------------------------------------------------
	addTitle(macroPage, "Fast Rebirth")
	macroStatus = addInfo(macroPage, 2, isMuscleGame and "Reps non-stop, tries a rebirth every few seconds. No pets, no pass." or wrong, 44)

	macroToggle = addToggle(macroPage, 3, "Fast Rebirth", function(v)
		if not allowed(macroToggle, macroStatus, v) then
			return
		end
		macroId += 1
		if v then
			stopOthers("macro")
			ensureTool("weight")
			macroStart = os.clock()
			macroBase = getRebirths()
			macroTotal, macroTries = 0, 0
			macroStatus.Text = "Running..."
			task.spawn(macroLoop, macroId)
		else
			macroStart = nil
			macroStatus.Text = "Stopped."
		end
	end)

	addSlider(macroPage, 4, "Reps per second", 0, REP_CAP, REP_CAP, function(v)
		macroRate = math.min(v, REP_CAP)
	end)
	addSlider(macroPage, 5, "Rebirth try every (s)", 1, 10, macroInterval, function(v)
		macroInterval = v
	end)
	addToolToggle(macroPage, 6, "Equip Weight", "weight")
	local macroLbl = addInfo(macroPage, 7, "Rebirths: - | Reps sent: 0", 50)

	--------------------------------------------------------
	-- LIVE STATS
	--------------------------------------------------------
	task.spawn(function()
		while farm.alive do
			pcall(function()
				local cur = getRebirths()

				if rebirthStart then
					local el = math.max(os.clock() - rebirthStart, 1)
					local gained = math.max(cur - rebirthBase, 0)
					rebirthLbl.Text = string.format("Rebirths: %s (+%s) | %s/h | %s\nReps sent: %s",
						fmtNum(cur), fmtNum(gained), fmtNum(gained / el * 3600), fmtTime(el), fmtNum(rebirthRepTotal))
				else
					rebirthLbl.Text = "Rebirths: " .. fmtNum(cur)
				end

				if strengthStart then
					local el = math.max(os.clock() - strengthStart, 1)
					strengthLbl.Text = string.format("Reps sent: %s | Avg: %d/s | %s",
						fmtNum(strengthTotal), math.floor(strengthTotal / el), fmtTime(el))
				else
					strengthLbl.Text = "Reps sent: 0 | Avg: 0/s"
				end

				if macroStart then
					local el = math.max(os.clock() - macroStart, 1)
					local gained = math.max(cur - macroBase, 0)
					macroLbl.Text = string.format("Rebirths: %s (+%s) | %s/h\nReps sent: %s | Tries: %d | %s",
						fmtNum(cur), fmtNum(gained), fmtNum(gained / el * 3600),
						fmtNum(macroTotal), macroTries, fmtTime(el))
				else
					macroLbl.Text = "Rebirths: " .. fmtNum(cur) .. " | Reps sent: 0"
				end
			end)
			task.wait(1)
		end
	end)

	-- Stops every loop and disconnects everything when the hub is closed
	farm.shutdown = function()
		farm.alive = false
		rebirthId += 1
		strengthId += 1
		macroId += 1
		toolLoopId += 1
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
	end
end

