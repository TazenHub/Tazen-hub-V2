local joinedAt = os.clock()

local function getPing()
	local ok, v = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	return ok and math.floor(v) or nil
end

local function fmtTime(s)
	s = math.floor(s)
	return string.format("%02d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end

local function plural(n)
	if n == 0 then
		return "no friends"
	end
	return n .. (n == 1 and " friend" or " friends")
end

local function refreshFriendsInServer()
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local ok, res = pcall(function()
				return player:IsFriendsWith(p.UserId)
			end)
			if ok and res then
				n += 1
			end
		end
	end
	friendSubs[1].Text = plural(n)
end

task.spawn(function()
	-- Region
	local ok, region = pcall(function()
		return LocalizationService:GetCountryRegionForPlayerAsync(player)
	end)
	serverSubs[4].Text = ok and tostring(region) or "N/A"

	-- Friends (total)
	local totalFriends, onlineFriends
	local okF, pagesObj = pcall(function()
		return Players:GetFriendsAsync(player.UserId)
	end)
	if okF then
		local count = 0
		while true do
			for _ in ipairs(pagesObj:GetCurrentPage()) do
				count += 1
			end
			if pagesObj.IsFinished then
				break
			end
			local okN = pcall(function()
				pagesObj:AdvanceToNextPageAsync()
			end)
			if not okN then
				break
			end
		end
		totalFriends = count
	end

	-- Friends (online)
	local okO, online = pcall(function()
		return player:GetFriendsOnline()
	end)
	if okO and type(online) == "table" then
		onlineFriends = #online
	end

	friendSubs[4].Text = totalFriends and (totalFriends .. " Friends") or "N/A"
	if onlineFriends then
		friendSubs[3].Text = onlineFriends .. " friends"
		friendSubs[2].Text = totalFriends and (math.max(totalFriends - onlineFriends, 0) .. " friends") or "N/A"
	else
		friendSubs[3].Text = "N/A"
		friendSubs[2].Text = "N/A"
	end
end)

task.spawn(function()
