					if noEgg >= 3 then
						return
					end
				elseif res == "eaten" then
					noEgg = 0
					eggEaten += 1
					eggStatus = "eaten"
					eggNextAt = tick() + EGG_DURATION
				end
			end
			task.wait(1)
		end
	end
	addSavedToggle(miscPage, 8, "Auto Eat Protein Egg", "MiscTab", "AutoEatEgg", false, function(v)
		eggRunId += 1
		if v then
			eggEaten = 0
			task.spawn(autoEggLoop, eggRunId)
		end
	end)

	local fpsFrames = 0
	connect2(RunService.Heartbeat, function()
		fpsFrames += 1
	end)
	local fpsLbl = addInfo(miscPage, 9, "FPS: --", 30)
	eggLbl = addInfo(miscPage, 10, "Egg: eaten 0 | boost: inactive", 30)
	local killMiscLbl = addInfo(miscPage, 11, "Kill status: " .. killStatus, 30)

	task.spawn(function()
		while farm.alive do
			task.wait(1)
			pcall(function()
				fpsLbl.Text = "FPS: " .. tostring(fpsFrames)
				fpsFrames = 0
				local left = eggNextAt - tick()
				eggLbl.Text = string.format("Egg: eaten %d | boost: %s | last: %s",
					eggEaten, (left > 0) and (math.floor(left) .. "s") or "inactive", eggStatus)
				killStatusLbl.Text = "Status: " .. killStatus
				killMiscLbl.Text = "Kill status: " .. killStatus
			end)
		end
	end)

	-- INFO TAB
	addTitle(infoPage, "Credits & Socials")
	addInfo(infoPage, 2, CONFIG.Title .. " — " .. CONFIG.Subtitle, 30)
	addButton(infoPage, 3, "Copy Discord Link", function()
		local ok = copy(CONFIG.Discord)
		killStatusLbl.Text = ok and "Discord link copied!" or CONFIG.Discord
	end)

	task.spawn(function()
		task.wait(1.5)
		local misc = loadConfig("MiscTab")
		if misc.AntiAfk then
			setAntiAfk(true)
		end
		if misc.AntiLag then
			antiLagStart()
		end
		if misc.UsernameSpoofer then
			spooferEnabled = true
			scanAndHook(player:WaitForChild("PlayerGui"))
			scanAndHook(workspace)
		end
	end)

	local prevShutdown = farm.shutdown
	farm.shutdown = function()
		if prevShutdown then
			prevShutdown()
		end
		killRunId += 1
		wheelRunId += 1
		eggRunId += 1
		setAntiAfk(false)
		if antiLagToggle and antiLagToggle.Value then
			antiLagStop()
		end
		for _, c in ipairs(conns2) do
			pcall(function()
				c:Disconnect()
			end)
		end
	end
end

