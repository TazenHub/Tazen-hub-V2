	--------------------------------------------------------
	local toolWanted, toolLoopId = nil, 0
	local toolToggles = {}

	local function unequipToolByName(keyword)
		pcall(function()
			local char = player.Character
			local backpack = player:FindFirstChild("Backpack")
			if not char or not backpack then
				return
			end
			keyword = keyword:lower()
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword, 1, true) then
					t.Parent = backpack
				end
			end
		end)
	end

	-- name = "weight" / "pushup" / nil (nothing). Keeps the tool equipped (even after a respawn).
	local function setTool(name)
		local old = toolWanted
		toolWanted = name
		toolLoopId += 1
		if old and old ~= name then
			unequipToolByName(old)
		end
		for _, e in ipairs(toolToggles) do
			e.toggle:Set(e.tool == name, true)
		end
		if name then
			local myId = toolLoopId
			task.spawn(function()
				while farm.alive and toolLoopId == myId do
					equipToolByName(name)
					task.wait(1)
				end
			end)
		end
	end

	local function ensureTool(default)
		if not toolWanted then
			setTool(default)
		end
	end

	local function addToolToggle(page, order, text, keyword)
		local t
		t = addToggle(page, order, text, function(v)
			setTool(v and keyword or nil)
		end)
		table.insert(toolToggles, { toggle = t, tool = keyword })
		return t
	end

	--------------------------------------------------------
	-- LOOPS (one per feature, completely independent)
	--------------------------------------------------------
	-- sends reps at `rate` per second while gate() is true
	local function repPump(gate, getRate, onSent)
		local muscle = findMuscleEvent()
		local carry, lastLook = 0, 0
		while gate() do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
			if muscle and muscle.Parent then
				carry += getRate() * dt
				local n = math.floor(carry)
				if n > 0 then
					carry -= n
					pcall(burst, muscle, n)
					onSent(n)
				end
			elseif tick() - lastLook > 1 then
				lastLook = tick()
				muscle = findMuscleEvent()
			end
		end
	end

	-- AUTO REBIRTH : rebirth requests non-stop + reps (so there is strength to rebirth with)
	local function rebirthLoop(myId)
		local function running()
			return farm.alive and rebirthId == myId
		end
		local remote = getRebirthRemote()
		if not remote then
			warn("[Tazen Hub] Rebirth remote not found")
			return
		end
		startWorkers(remote, REBIRTH_WORKERS, running)
		repPump(running, function()
			return REP_CAP
		end, function(n)
			rebirthRepTotal += n
		end)
	end

	-- FAST FARMING : only reps
	local function strengthLoop(myId)
		repPump(function()
			return farm.alive and strengthId == myId
		end, function()
			return strRate
		end, function(n)
			strengthTotal += n
		end)
	end

	-- FAST REBIRTH : reps non-stop + a rebirth attempt every few seconds
	local function macroLoop(myId)
		local function running()
			return farm.alive and macroId == myId
		end
		local remote = getRebirthRemote()
		if not remote then
			warn("[Tazen Hub] Rebirth remote not found")
			return
		end

		local muscle = findMuscleEvent()
		local rebirthStat = getRebirthStat()
		local carry, lastLook = 0, 0
		local trying, tryEnd, nextTry, initial, token = false, 0, 0, 0, 0

		while running() do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)

			-- 1) reps never stop
			if muscle and muscle.Parent then
				carry += macroRate * dt
				local n = math.floor(carry)
				if n > 0 then
					carry -= n
					pcall(burst, muscle, n)
					macroTotal += n
				end
			elseif tick() - lastLook > 1 then
				lastLook = tick()
				muscle = findMuscleEvent()
			end

			-- 2) every `macroInterval` seconds, try to rebirth for a short window
			local now = tick()
			if trying then
				local ok = rebirthStat and rebirthStat.Value > initial
				if ok or now >= tryEnd then
					trying = false
					nextTry = now + macroInterval
				end
			elseif now >= nextTry then
				trying = true
				tryEnd = now + TRY_WINDOW
				initial = rebirthStat and rebirthStat.Value or 0
				macroTries += 1
				token += 1
				local myToken = token
				startWorkers(remote, MACRO_WORKERS, function()
					return running() and trying and token == myToken
				end)
			end
		end
		trying = false
	end

	--------------------------------------------------------
	-- SHARED STOP / GUARD LOGIC
	--------------------------------------------------------
	local rebirthToggle, strengthToggle, macroToggle
	local rebirthStatus, strengthStatus, macroStatus

	local function stopRebirth()
		rebirthId += 1
		rebirthStart = nil
		rebirthToggle:Set(false, true)
		rebirthStatus.Text = "Stopped."
	end
	local function stopStrength()
		strengthId += 1
		strengthStart = nil
		strengthToggle:Set(false, true)
		strengthStatus.Text = "Stopped."
	end
	local function stopMacro()
		macroId += 1
		macroStart = nil
		macroToggle:Set(false, true)
		macroStatus.Text = "Stopped."
	end

	-- the three features all send reps, so only one can run at a time
	local function stopOthers(except)
		if except ~= "rebirth" and rebirthToggle.Value then
			stopRebirth()
		end
		if except ~= "strength" and strengthToggle.Value then
			stopStrength()
		end
		if except ~= "macro" and macroToggle.Value then
			stopMacro()
		end
	end

	local function allowed(toggle, status, v)
		if v and not isMuscleGame then
			toggle:Set(false, true)
			status.Text = "Wrong game: Muscle Legends only."
			return false
		end
		return true
	end

	local wrong = "Wrong game: Muscle Legends only."

