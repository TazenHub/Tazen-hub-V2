local tabs = {}
local function selectTab(name)
	for n, t in pairs(tabs) do
		local on = (n == name)
		t.page.Visible = on
		TweenService:Create(t.btn, TweenInfo.new(0.2), {
			BackgroundColor3 = on and C.PinkDark or C.Card,
		}):Play()
		t.stroke.Color = on and C.Pink or C.Stroke
		setIconColor(t.icon, on and C.White or C.Gray)
	end
end

local function addTab(name, drawIcon)
	local page = make("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = C.Pink,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, pages)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, page)
	make("UIPadding", { PaddingRight = UDim.new(0, 6) }, page)

	local btn = make("TextButton", {
		Size = UDim2.new(0, 38, 0, 38),
		BackgroundColor3 = C.Card,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = #sideBar:GetChildren(),
	}, sideBar)
	corner(btn, 9)
	local st = stroke(btn, C.Stroke, 1)

	local icon = newIcon(btn)
	drawIcon(icon)
	setIconColor(icon, C.Gray)

	tabs[name] = { btn = btn, page = page, stroke = st, icon = icon }
	btn.MouseButton1Click:Connect(function()
		selectTab(name)
	end)
	return page
end

