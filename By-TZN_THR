local function card(parent, pos, size, title, sub, cA, cB, rot, asButton)
	local f = make(asButton and "TextButton" or "Frame", {
		Position = pos,
		Size = size,
		BackgroundColor3 = C.Card,
		BorderSizePixel = 0,
	}, parent)
	if asButton then
		f.Text = ""
		f.AutoButtonColor = false
	end
	corner(f, 10)
	stroke(f, C.Stroke, 1)
	if cA then
		gradient(f, cA, cB or C.Bg, rot or 45)
	end
	label(f, title, 14, B, C.White, UDim2.new(0, 12, 0, 8), UDim2.new(1, -24, 0, 18))
	local subLbl = label(f, sub, 10, G, Color3.fromRGB(215, 205, 212), UDim2.new(0, 12, 0, 26), UDim2.new(1, -24, 0, 24))
	subLbl.TextWrapped = true
	subLbl.TextYAlignment = Enum.TextYAlignment.Top
	return f, subLbl
end

local function tileGrid(parent, pos, size, cellH, items)
	local g = make("Frame", { BackgroundTransparency = 1, Position = pos, Size = size }, parent)
	make("UIGridLayout", {
		CellSize = UDim2.new(0.5, -3, 0, cellH),
		CellPadding = UDim2.new(0, 6, 0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, g)
	local subs = {}
	for i, it in ipairs(items) do
		local t = make("TextButton", {
			BackgroundColor3 = C.Tile,
			BackgroundTransparency = 0.25,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = i,
		}, g)
		corner(t, 8)
		label(t, it[1], 11, B, C.White, UDim2.new(0, 8, 0, 6), UDim2.new(1, -12, 0, 14))
		subs[i] = label(t, it[2], 10, G, C.Gray, UDim2.new(0, 8, 0, 21), UDim2.new(1, -12, 0, 12))
		if it[3] then
			t.MouseButton1Click:Connect(it[3])
		end
	end
	return subs
end

