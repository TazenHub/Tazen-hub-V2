	local REP_CAP = 659
	local REBIRTH_WORKERS = 3
	local MUSCLE_PLACE_ID = 3623096087

	local isMuscleGame = game.PlaceId == MUSCLE_PLACE_ID

	local rebirthId, strengthId, macroId = 0, 0, 0
	local rebirthStart, strengthStart, macroStart = nil, nil, nil
	local lastRebirthTime = nil
	local lastMacroRebirthTime = nil
	local conns = {}

	local FORMAT_UNITS = {
		{ 1e36, "Ud" }, { 1e33, "Dc" }, { 1e30, "No" }, { 1e27, "Oc" }, { 1e24, "Sp" }, { 1e21, "Sx" },
		{ 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "k" },
	}
	local function formatNumber(val)
		if type(val) ~= "number" or val ~= val then
			return "0"
		end
		for _, u in ipairs(FORMAT_UNITS) do
			if val >= u[1] then
				return string.format("%.2f%s", val / u[1], u[2])
			end
		end
		return tostring(math.floor(val))
	end

	local function formatExactNumber(val)
		if type(val) ~= "number" or val ~= val then
			return "0"
		end
		local formatted = tostring(math.floor(val))
		local k
		while true do
			formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
			if k == 0 then
				break
			end
		end
		return formatted
	end

	local function formatDual(val)
		return string.format("%s (%s)", formatExactNumber(val), formatNumber(val))
	end

	local WINDOW = 30

	local function newTracker(window, minEvents)
		return { gained = 0, history = {}, lastT = nil, events = 0, lastVal = nil, window = window or WINDOW, minEvents = minEvents }
	end

	local function trackerReset(st)
		st.gained, st.history, st.lastT, st.events, st.lastVal = 0, {}, nil, 0, nil
	end

	local function trackerGain(st, n, now)
		if n <= 0 then
			return
		end
		st.gained += n
		st.events += 1
		st.lastT = now
	end

	local function trackerRecord(st, now)
		local h, w = st.history, st.window
		h[#h + 1] = { t = now, g = st.gained }
		while #h > 2 and now - h[2].t >= w do
			table.remove(h, 1)
		end
	end

	local function trackerPollValue(st, now, currentVal)
		if st.lastVal == nil then
			st.lastVal = currentVal
			return
		end
		if currentVal > st.lastVal then
			trackerGain(st, currentVal - st.lastVal, now)
		end
		st.lastVal = currentVal
	end

	local function trackerRate(st, now, startT)
		if st.minEvents and st.events < st.minEvents then
			return 0
		end
		local elapsed = math.max(1, now - startT)
		local h = st.history
		local r = st.gained / elapsed
		if elapsed > st.window and #h >= 2 then
			local dt = now - h[1].t
			if dt >= 5 then
				r = math.max(0, (st.gained - h[1].g) / dt)
			end
		end
		return r
	end

	local function trackerStrengthText(prefix, st, now, startT)
		local r = trackerRate(st, now, startT)
		return string.format("%s Tot: %s (+%s/s) | 1m: %s | 1h: %s | 1d: %s | 1w: %s | 1mo: %s",
			prefix, formatNumber(st.gained), formatNumber(r),
			formatNumber(r * 60), formatNumber(r * 3600), formatNumber(r * 86400),
			formatNumber(r * 604800), formatNumber(r * 2592000))
	end

	local function trackerRebirthText(prefix, st, now, startT)
		local r = trackerRate(st, now, startT)
		local function p(x)
			return formatNumber(math.floor(x + 0.5))
		end
		return string.format("%s Tot: %s | 1m: %s | 1h: %s | 1d: %s | 1w: %s | 1mo: %s",
			prefix, formatNumber(st.gained), p(r * 60), p(r * 3600), p(r * 86400), p(r * 604800), p(r * 2592000))
	end

