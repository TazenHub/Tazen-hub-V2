	local function killLoop(myId, mode)
		while killRunId == myId and farm.alive do
			pcall(function()
				local character = player.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if not hrp then
					killStatus = "Waiting for character..."
					task.wait(1)
					return
				end

				local target, minDist = nil, math.huge
				for _, plr in ipairs(Players:GetPlayers()) do
					local wanted = (mode == "all" and plr ~= player and not whitelistPlayers[plr.Name])
						or (mode == "target" and targetPlayers[plr.Name] and not whitelistPlayers[plr.Name])
					if wanted then
						local pChar = plr.Character
						local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
						local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
						if pHrp and pHum and pHum.Health > 0 then
							local d = (hrp.Position - pHrp.Position).Magnitude
							if d < minDist then
								minDist = d
								target = plr
							end
						end
					end
				end

				if not target then
					killStatus = "No target available..."
					task.wait(0.5)
					return
				end

				local pChar = target.Character
				local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
				local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
				killStatus = "Attacking: " .. target.Name
				equipFists()

				local wasAlive = true
				local deathConn
				if pHum then
					deathConn = pHum.Died:Connect(function()
						wasAlive = false
						if deathConn then
							deathConn:Disconnect()
						end
					end)
				end

				while killRunId == myId and farm.alive and target.Parent and pHum and pHum.Health > 0 and wasAlive do
					local stillWanted = (mode == "all" and not whitelistPlayers[target.Name])
						or (mode == "target" and targetPlayers[target.Name] and not whitelistPlayers[target.Name])
					if not stillWanted then
						break
					end
					equipFists()
					if hrp and pHrp then
						hrp.CFrame = pHrp.CFrame * CFrame.new(0, 3, 2)
					end
					local tool = character:FindFirstChild("Fight") or character:FindFirstChild("Punch")
					if tool and tool:IsA("Tool") then
						pcall(function()
							tool:Activate()
						end)
					end
					task.wait(0.1)
				end
				if deathConn then
					deathConn:Disconnect()
				end
			end)
			task.wait(0.1)
		end
	end

