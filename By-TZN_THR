local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Rayon de détection des hitboxes ennemies (en studs)
local DODGE_RADIUS = 6
local isDodging = false

local function performDodge()
	if isDodging then return end
	isDodging = true
	
	-- Petite téléportation rapide de côté (effet "Ultra Instinct")
	local randomOffset = Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
	rootPart.CFrame = rootPart.CFrame + randomOffset
	
	task.wait(0.15)
	isDodging = false
end

-- Surveillance continue des parties proches (simule l'esquive d'hitbox)
RunService.Heartbeat:Connect(function()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- Parcourt tous les autres joueurs pour vérifier la proximité des armes/poings
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local enemyRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			if enemyRoot then
				local distance = (hrp.Position - enemyRoot.Position).Magnitude
				-- Si un ennemi est trop près avec une attaque potentielle
				if distance < DODGE_RADIUS then
					performDodge()
					break
				end
			end
		end
	end
end)
