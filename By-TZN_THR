	-- Envoi pur et optimisé des reps (utilisé uniquement sur Auto Rebirth & Fast Farming)
	local function startRepBurst(runningCheck)
		task.spawn(function()
			local carry = 0
			while runningCheck() do
				local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
				carry += REP_CAP * dt
				local n = math.floor(carry)
				if n > 0 then
					carry -= n
					local muscleEvent = getMuscleEvent()
					if muscleEvent then
						pcall(burst, muscleEvent, n)
					end
				end
			end
		end)
	end

	local function startWorkers(remote, count, gate)
		for _ = 1, count do
			task.spawn(function()
				while gate() do
					pcall(remote.InvokeServer, remote, "rebirthRequest")
					RunService.Heartbeat:Wait()
				end
			end)
		end
	end

	local function getPetScore(pet)
		local o = pet:FindFirstChild("RepSpeed") or pet:FindFirstChild("Rep Speed")
		if o and (o:IsA("NumberValue") or o:IsA("IntValue")) then
			return o.Value
		end
		local attr = pet:GetAttribute("RepSpeed") or pet:GetAttribute("Rep Speed")
		if attr then
			return tonumber(attr) or 0
		end
		local lvl = pet:FindFirstChild("Level") or pet:FindFirstChild("Lvl")
		if lvl and lvl.Value then
			return tonumber(lvl.Value) or 0
		end
		return 1
	end

	local function scanPets(petsFolder)
		local all, tribal, swift, raw = {}, {}, {}, {}
		for _, folder in ipairs(petsFolder:GetChildren()) do
			if folder:IsA("Folder") then
				for _, pet in ipairs(folder:GetChildren()) do
					all[#all + 1] = pet
					local name = pet.Name:lower()
					local pn = pet:FindFirstChild("PetName")
					if pn then
						name = name .. " " .. tostring(pn.Value):lower()
					end
					if name:find("tribal overlord", 1, true) or name:find("eclipse devourer", 1, true)
						or name:find("hydra", 1, true) or name:find("titanium", 1, true) then
						tribal[#tribal + 1] = pet
					elseif name:find("swift samurai", 1, true) then
						swift[#swift + 1] = pet
					elseif name:find("omega", 1, true) or name:find("overlord", 1, true) or name:find("boss", 1, true)
						or name:find("mythic", 1, true) or name:find("legendary", 1, true) then
						raw[#raw + 1] = { pet = pet, score = getPetScore(pet) }
					end
				end
			end
		end
		table.sort(raw, function(a, b)
			return a.score > b.score
		end)
		local repPets = {}
		local tribalPets = {}
		for _, s in ipairs(swift) do
			repPets[#repPets + 1] = s
		end
		for _, e in ipairs(raw) do
			repPets[#repPets + 1] = e.pet
		end
		for _, t in ipairs(tribal) do
			tribalPets[#tribalPets + 1] = t
		end
		return all, tribalPets, repPets
	end

	-- 1. AUTO REBIRTH : reps purs + rebirthRequest (sans pets ni pass auto rep)
	local function rebirthLoop(myId)
