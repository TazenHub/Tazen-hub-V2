		gradient(b, C.Pink, C.PinkDark, 0)
		b.MouseButton1Click:Connect(fn)
		return b
	end

	local function addToggle(order, text, callback)
		local r = rowFrame(order, 40)
		label(r, text, 12, G, C.White, UDim2.new(0, 12, 0, 0), UDim2.new(1, -70, 1, 0))
		local sw = make("TextButton", {
			Size = UDim2.new(0, 38, 0, 20),
			Position = UDim2.new(1, -50, 0.5, -10),
			BackgroundColor3 = C.Tile,
			Text = "",
			AutoButtonColor = false,
		}, r)
		corner(sw, 10)
		local swStroke = stroke(sw, C.Stroke, 1)
		local knob = make("Frame", {
			Size = UDim2.new(0, 14, 0, 14),
			Position = UDim2.new(0, 3, 0.5, -7),
			BackgroundColor3 = C.Gray,
		}, sw)
		corner(knob, 7)

		local obj = { Value = false }
		function obj:Set(v, silent)
			self.Value = v
			TweenService:Create(knob, TweenInfo.new(0.15), {
				Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
				BackgroundColor3 = v and C.White or C.Gray,
			}):Play()
			TweenService:Create(sw, TweenInfo.new(0.15), {
				BackgroundColor3 = v and C.PinkDark or C.Tile,
			}):Play()
			swStroke.Color = v and C.Pink or C.Stroke
			if callback and not silent then
				callback(v)
			end
		end
		sw.MouseButton1Click:Connect(function()
			obj:Set(not obj.Value)
		end)
		return obj
	end

	local function addSlider(order, text, min, max, default, callback)
		local r = rowFrame(order, 54)
		label(r, text, 12, G, C.White, UDim2.new(0, 12, 0, 6), UDim2.new(1, -100, 0, 18))
		local val = label(r, tostring(default), 12, B, C.Pink, UDim2.new(1, -82, 0, 6), UDim2.new(0, 70, 0, 18), Enum.TextXAlignment.Right)
		local track = make("Frame", {
			Size = UDim2.new(1, -24, 0, 6),
			Position = UDim2.new(0, 12, 0, 36),
			BackgroundColor3 = C.Tile,
			BorderSizePixel = 0,
		}, r)
		corner(track, 3)
		local fill = make("Frame", {
			Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
			BackgroundColor3 = C.Pink,
			BorderSizePixel = 0,
		}, track)
		corner(fill, 3)
		local hit = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.new(0, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = "",
		}, r)

		local dragging = false
		local function setFromX(x)
			local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local v = math.floor(min + rel * (max - min) + 0.5)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			val.Text = tostring(v)
			callback(v)
		end
		local function isPointer(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end
		hit.InputBegan:Connect(function(input)
			if isPointer(input) then
				dragging = true
				funcs.ScrollingEnabled = false
				setFromX(input.Position.X)
			end
		end)
		table.insert(conns, UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end))
		table.insert(conns, UserInputService.InputEnded:Connect(function(input)
			if dragging and isPointer(input) then
				dragging = false
				funcs.ScrollingEnabled = true
			end
		end))
		callback(default)
	end

	--------------------------------------------------------
	-- GAME HELPERS
	--------------------------------------------------------
	local function fmtNum(v)
		if type(v) ~= "number" or v ~= v then
			return "0"
		end
		local units = {
			{ 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "k" },
		}
		for _, u in ipairs(units) do
			if v >= u[1] then
				return string.format("%.2f%s", v / u[1], u[2])
			end
		end
		return tostring(math.floor(v))
	end

	local function getRebirths()
		local ls = player:FindFirstChild("leaderstats")
		local rb = ls and (ls:FindFirstChild("Rebirths") or ls:FindFirstChild("Rebirth"))
		if rb and rb:IsA("ValueBase") then
			return tonumber(rb.Value) or 0
		end
		return 0
	end

	local function getRemotes()
		local rEvents = ReplicatedStorage:WaitForChild("rEvents", 5)
		if not rEvents then
			return {}
		end
		return {
			rebirth = rEvents:WaitForChild("rebirthRemote", 5),
			equipPet = rEvents:WaitForChild("equipPetEvent", 5),
			autoLift = rEvents:WaitForChild("savePlayerSizeEvent", 5),
		}
	end

	local function findMuscleEvent()
		local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
		return player:FindFirstChild("muscleEvent")
			or (player.Character and player.Character:FindFirstChild("muscleEvent"))
			or (rEvents and rEvents:FindFirstChild("muscleEvent"))
	end

	local function toggleAutoLift(remotes)
		if remotes.autoLift then
			pcall(remotes.autoLift.FireServer, remotes.autoLift, "toggleAutoLift")
		end
	end

	local function equipToolByName(keyword)
		pcall(function()
			local char = player.Character
			local backpack = player:FindFirstChild("Backpack")
			if not char or not backpack then
				return
			end
			keyword = keyword:lower()
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword, 1, true) then
					return -- already equipped
				end
			end
			for _, t in ipairs(backpack:GetChildren()) do
				if t:IsA("Tool") and t.Name:lower():find(keyword, 1, true) then
					t.Parent = char
					return
				end
			end
		end)
	end

	local function getPetScore(pet)
		local o = pet:FindFirstChild("RepSpeed") or pet:FindFirstChild("Rep Speed")
		if o and (o:IsA("NumberValue") or o:IsA("IntValue")) then
			return o.Value
		end
		local attr = pet:GetAttribute("RepSpeed") or pet:GetAttribute("Rep Speed")
		if attr then
			return tonumber(attr) or 0
		end
		local lvl = pet:FindFirstChild("Level") or pet:FindFirstChild("Lvl")
		if lvl and lvl.Value then
			return tonumber(lvl.Value) or 0
		end
		return 1
	end

	-- Sorts the pets into: rebirth pets (x2), swift samurai, and the best rep pets
	local function scanPets(petsFolder)
		local all, tribal, swift, raw = {}, {}, {}, {}
		for _, folder in ipairs(petsFolder:GetChildren()) do
			if folder:IsA("Folder") then
				for _, pet in ipairs(folder:GetChildren()) do
					all[#all + 1] = pet
					local name = pet.Name:lower()
					local pn = pet:FindFirstChild("PetName")
					if pn then
						name = name .. " " .. tostring(pn.Value):lower()
					end
					if name:find("tribal overlord", 1, true) or name:find("eclipse devourer", 1, true)
						or name:find("hydra", 1, true) or name:find("titanium", 1, true) then
						tribal[#tribal + 1] = pet
					elseif name:find("swift samurai", 1, true) then
						swift[#swift + 1] = pet
					elseif name:find("omega", 1, true) or name:find("overlord", 1, true) or name:find("boss", 1, true)
						or name:find("mythic", 1, true) or name:find("legendary", 1, true) then
						raw[#raw + 1] = { pet = pet, score = getPetScore(pet) }
					end
				end
			end
		end
		table.sort(raw, function(a, b)
			return a.score > b.score
		end)
		local repPets = {}
		for _, s in ipairs(swift) do
			repPets[#repPets + 1] = s
		end
		for _, e in ipairs(raw) do
			repPets[#repPets + 1] = e.pet
		end
		return all, tribal, repPets
	end

	local function burst(ev, n)
		for _ = 1, n do
			ev:FireServer("rep")
		end
	end

	-- Several rebirth requests in flight at once (InvokeServer waits for the server's reply,
	-- so a single loop only ever had one request in the air)
	local function startWorkers(remote, count, gate)
		for _ = 1, count do
			task.spawn(function()
				while gate() do
					pcall(remote.InvokeServer, remote, "rebirthRequest")
					RunService.Heartbeat:Wait()
				end
			end)
		end
	end

	--------------------------------------------------------
	-- FARM LOOPS
	--------------------------------------------------------
	local function fastRebirthLoop(myId)
		local function running()
			return farm.alive and fastId == myId
		end
		local remotes = getRemotes()
		if not (remotes.rebirth and remotes.equipPet) then
			warn("[Tazen Hub] Missing remotes for Fast Rebirth")
			return
		end
		local equipPet = remotes.equipPet
		local function petCall(action, pet)
			pcall(equipPet.FireServer, equipPet, action, pet)
		end

		toggleAutoLift(remotes)

		local petsFolder = player:FindFirstChild("petsFolder")
		while running() and not petsFolder do
			task.wait(1)
			petsFolder = player:FindFirstChild("petsFolder")
		end

		local muscle = findMuscleEvent()
		local ls = player:FindFirstChild("leaderstats")
		local rebirthsStat = ls and ls:FindFirstChild("Rebirths")

		local all, tribal, repPets = {}, {}, {}
		local cycles = 0

		while running() do
			-- Re-scan the pets only every 15 cycles (V1 re-scanned and re-equipped everything each time)
			if cycles % 15 == 0 then
				all, tribal, repPets = scanPets(petsFolder)
				for _, pet in ipairs(all) do
					petCall("unequipPet", pet)
				end
				muscle = muscle and muscle.Parent and muscle or findMuscleEvent()
			end
			cycles += 1

			-- 1) rep pets on, fast reps
			for _, pet in ipairs(repPets) do
				petCall("equipPet", pet)
			end
			local t0, carry = tick(), 0
			while running() and tick() - t0 < REP_PHASE do
				local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
				if muscle then
					carry += REP_CAP * dt
					local n = math.floor(carry)
					if n > 0 then
						carry -= n
						pcall(burst, muscle, n)
					end
				end
			end
			for _, pet in ipairs(repPets) do
				petCall("unequipPet", pet)
			end
			if not running() then
				break
			end

			-- 2) rebirth pets on, spam the rebirth request until it goes through (or times out)
			for _, pet in ipairs(tribal) do
				petCall("equipPet", pet)
			end
			local initial = rebirthsStat and rebirthsStat.Value or 0
			local done = false
			startWorkers(remotes.rebirth, WORKERS, function()
				return running() and not done
			end)
			local t1 = tick()
			local limit = rebirthsStat and REBIRTH_TIMEOUT or 0.5
			while running() and not done and tick() - t1 < limit do
				RunService.Heartbeat:Wait()
				if rebirthsStat and rebirthsStat.Value > initial then
					done = true
				end
			end
			done = true
			for _, pet in ipairs(tribal) do
				petCall("unequipPet", pet)
			end
		end

		toggleAutoLift(remotes)
	end

	local function autoRebirthLoop(myId)
		local function running()
			return farm.alive and autoId == myId
		end
		local remotes = getRemotes()
		if not remotes.rebirth then
			warn("[Tazen Hub] Missing rebirth remote")
			return
		end
		toggleAutoLift(remotes)
		startWorkers(remotes.rebirth, WORKERS, running)
		while running() do
			task.wait(0.5)
		end
		toggleAutoLift(remotes)
	end

	local function fastRepLoop(myId)
		local muscle = findMuscleEvent()
		local carry, lastLook = 0, 0
		while farm.alive and repId == myId do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
			if muscle and muscle.Parent then
				if repRate > 0 then
					carry += repRate * dt
					local n = math.floor(carry)
					if n > 0 then
						carry -= n
						pcall(burst, muscle, n)
						repTotal += n
					end
				end
			elseif tick() - lastLook > 1 then
				lastLook = tick()
				muscle = findMuscleEvent()
			end
		end
	end

