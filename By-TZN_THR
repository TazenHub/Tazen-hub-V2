	-- PAGE LAYOUT
	--------------------------------------------------------
	label(funcs, "Fast Farm", 14, B, C.White, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 20)).LayoutOrder = 1
	local statusLbl = addInfo(2, isMuscleGame and "Ready." or "Farm tools only work in Muscle Legends (wrong game).", 30)

	local fastToggle, autoToggle, repToggle

	local function sessionBegin()
		sessionStart = os.clock()
		rebirthStart = getRebirths()
	end

	local function allowed(toggle, v)
		if v and not isMuscleGame then
			toggle:Set(false, true)
			statusLbl.Text = "Wrong game: these tools only work in Muscle Legends."
			return false
		end
		return true
	end

	fastToggle = addToggle(3, "Fast Rebirth (needs pack)", function(v)
		if not allowed(fastToggle, v) then
			return
		end
		fastId += 1
		if v then
			autoId += 1
			autoToggle:Set(false, true)
			sessionBegin()
			statusLbl.Text = "Fast Rebirth running..."
			task.spawn(fastRebirthLoop, fastId)
		else
			sessionStart = nil
			statusLbl.Text = "Fast Rebirth stopped."
		end
	end)

	autoToggle = addToggle(4, "Auto Rebirth (no pack)", function(v)
		if not allowed(autoToggle, v) then
			return
		end
		autoId += 1
		if v then
			fastId += 1
			fastToggle:Set(false, true)
			sessionBegin()
			statusLbl.Text = "Auto Rebirth running..."
			task.spawn(autoRebirthLoop, autoId)
		else
			sessionStart = nil
			statusLbl.Text = "Auto Rebirth stopped."
		end
	end)

	repToggle = addToggle(5, "Fast Strength", function(v)
		if not allowed(repToggle, v) then
			return
		end
		repId += 1
		if v then
			repStart = os.clock()
			repTotal = 0
			statusLbl.Text = "Fast Strength running..."
			task.spawn(fastRepLoop, repId)
		else
			repStart = nil
			statusLbl.Text = "Fast Strength stopped."
		end
	end)

	addSlider(6, "Reps per second", 0, REP_CAP, REP_CAP, function(v)
		repRate = math.min(v, REP_CAP)
	end)

	addButton(7, "Equip Weight", function()
		equipToolByName("weight")
	end).LayoutOrder = 7
	addButton(8, "Equip Pushup", function()
		equipToolByName("pushup")
	end).LayoutOrder = 8

	local rebirthLbl = addInfo(9, "Rebirths: -", 34)
	local repLbl = addInfo(10, "Reps sent: 0 | Avg: 0/s", 34)

	task.spawn(function()
		while farm.alive do
			pcall(function()
				local cur = getRebirths()
				if sessionStart then
					local el = math.max(os.clock() - sessionStart, 1)
					local gained = math.max(cur - rebirthStart, 0)
					rebirthLbl.Text = string.format("Rebirths: %s (+%s) | %s/h | %s",
						fmtNum(cur), fmtNum(gained), fmtNum(gained / el * 3600), fmtTime(el))
				else
					rebirthLbl.Text = "Rebirths: " .. fmtNum(cur)
				end
				if repStart then
					local el = math.max(os.clock() - repStart, 1)
					repLbl.Text = string.format("Reps sent: %s | Avg: %d/s | %s",
						fmtNum(repTotal), math.floor(repTotal / el), fmtTime(el))
				else
					repLbl.Text = "Reps sent: 0 | Avg: 0/s"
				end
			end)
			task.wait(1)
		end
	end)

	-- Stops every loop and disconnects everything when the hub is closed
	farm.shutdown = function()
		farm.alive = false
		fastId += 1
		autoId += 1
		repId += 1
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
	end
end

